# PostgreSQL connection string. Example for a local database:
DATABASE_URL=postgresql://postgres:password@localhost:5432/tradesphere

# Use a long random value. Do not reuse a database password.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com

# Browser origin allowed by the backend CORS policy
FRONTEND_URL=http://localhost:5173
